{
  "name": "pocket-practice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @pocket-practice/music-theory-engine --filter @pocket-practice/fretboard-engine build",
    "dev": "pnpm --filter @pocket-practice/web dev",
    "lint": "pnpm build:packages && pnpm -r lint",
    "test": "pnpm build:packages && pnpm -r test",
    "typecheck": "pnpm build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
